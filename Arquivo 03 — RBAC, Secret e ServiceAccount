manifests/03-rbac.yaml

apiVersion: v1
kind: Secret
metadata:
  name: segredo-web
  namespace: simulado-nuvem
type: Opaque
stringData:
  usuario: administrador
  senha: SenhaSimulada123

---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: web-sa
  namespace: simulado-nuvem

---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: web-role
  namespace: simulado-nuvem
rules:
  - apiGroups: [""]
    resources: ["pods"]
    verbs: ["get", "list", "watch"]

---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: web-rolebinding
  namespace: simulado-nuvem
subjects:
  - kind: ServiceAccount
    name: web-sa
    namespace: simulado-nuvem
roleRef:
  kind: Role
  name: web-role
  apiGroup: rbac.authorization.k8s.io
