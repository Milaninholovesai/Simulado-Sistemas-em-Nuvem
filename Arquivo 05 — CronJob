manifests/05-cronjob.yaml

apiVersion: batch/v1
kind: CronJob
metadata:
  name: verifica-web
  namespace: simulado-nuvem
spec:
  schedule: "*/5 * * * *"
  concurrencyPolicy: Forbid
  successfulJobsHistoryLimit: 3
  failedJobsHistoryLimit: 3
  jobTemplate:
    spec:
      template:
        spec:
          restartPolicy: Never
          containers:
            - name: verifica
              image: busybox:1.36
              command:
                - /bin/sh
                - -c
                - wget -qO- http://web
